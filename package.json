{
  "name": "neon-geometry-tactical-local",
  "version": "48.0.0",
  "private": true,
  "description": "School-safe local pixel-art tactical game with a selectable armor catalog, simple Pulse Pistol, strict projectile limits, improved fixed maps, three-strike trigonometry checkpoints and automatic local results.",
  "main": "school-game/main.js",
  "scripts": {
    "prepare:icons": "node scripts/prepare-desktop-assets.js",
    "prepare:school-assets": "node scripts/prepare-school-game-assets.js",
    "prepare": "npm run prepare:icons && npm run prepare:school-assets",
    "test": "npm run prepare && node --check school-game/main.js && node --check school-game/preload.js && node --check school-game/game.js && node scripts/school-game-static-test.js",
    "start": "npm run prepare && electron .",
    "dist:win": "npm run prepare && electron-builder --win nsis portable --x64",
    "dir:win": "npm run prepare && electron-builder --win dir --x64"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.9.1"
  },
  "build": {
    "appId": "co.jpanalyst.neongeometrytactical.pixel.local",
    "productName": "Neon Geometry Tactical Pixel Local",
    "copyright": "Copyright © 2026 Juan Diego Pérez",
    "asar": true,
    "directories": {
      "output": "dist/school-windows",
      "buildResources": "desktop/assets"
    },
    "files": [
      "package.json",
      "school-game/**/*",
      "!school-game/assets/**/*.base64"
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Neon Geometry Tactical Pixel Local",
      "uninstallDisplayName": "Neon Geometry Tactical Pixel Local"
    },
    "portable": {
      "artifactName": "Neon-Geometry-Tactical-Pixel-Local-${version}-Portable-${arch}.${ext}"
    }
  }
}
