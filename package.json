{
  "name": "geometry-tactical-consolidated-local",
  "version": "49.0.0",
  "private": true,
  "description": "Consolidated school-safe local pixel-art tactical game with two complete rooms, one shared player character, three-person cooperative controls, full-level defeat resets, dynamic enemy AI, trigonometry checkpoints and automatic local results.",
  "main": "school-game/main.js",
  "scripts": {
    "prepare:icons": "node scripts/prepare-desktop-assets.js",
    "prepare:school-assets": "node scripts/prepare-school-game-assets.js",
    "prepare:consolidated": "node scripts/prepare-consolidated-v49.js",
    "prepare": "npm run prepare:icons && npm run prepare:school-assets && npm run prepare:consolidated",
    "test": "npm run prepare && node --check school-game/main.js && node --check school-game/preload.js && node --check school-game/game-v49.js && node scripts/school-game-static-test.js",
    "start": "npm run prepare && electron .",
    "dist:win": "npm run prepare && electron-builder --win nsis portable --x64",
    "dir:win": "npm run prepare && electron-builder --win dir --x64"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.9.1"
  },
  "build": {
    "appId": "co.jpanalyst.geometrytactical.consolidated.local",
    "productName": "Geometry Tactical Consolidated Local",
    "copyright": "Copyright © 2026 Juan Diego Pérez",
    "asar": true,
    "directories": {
      "output": "dist/school-windows",
      "buildResources": "desktop/assets"
    },
    "files": [
      "package.json",
      "school-game/**/*",
      "!school-game/assets/**/*.base64",
      "!school-game/game.js"
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Geometry Tactical Consolidated Local",
      "uninstallDisplayName": "Geometry Tactical Consolidated Local"
    },
    "portable": {
      "artifactName": "Geometry-Tactical-Consolidated-Local-${version}-Portable-${arch}.${ext}"
    }
  }
}
