{
  "name": "geometry-tactical-professional-v2-local",
  "version": "50.0.0",
  "private": true,
  "description": "Professional two-level local pixel-art tactical game using explicit V2 animation atlases, A* enemy navigation, three-person shared controls, three-strike trigonometry checkpoints and automatic local results.",
  "main": "school-game/main.js",
  "scripts": {
    "prepare:icons": "node scripts/prepare-desktop-assets.js",
    "prepare": "node scripts/prepare-professional-v50.js && npm run prepare:icons",
    "test": "npm run prepare && node --check school-game/main.js && node --check school-game/preload.js && node --check school-game/game.js && node scripts/school-game-static-test.js",
    "start": "npm run prepare && electron .",
    "dist:win": "npm run prepare && electron-builder --win nsis portable --x64",
    "dir:win": "npm run prepare && electron-builder --win dir --x64"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.9.1"
  },
  "build": {
    "appId": "co.jpanalyst.geometrytactical.professionalv2.local",
    "productName": "Geometry Tactical Professional V2 Local",
    "copyright": "Copyright © 2026 Juan Diego Pérez",
    "asar": true,
    "directories": {
      "output": "dist/professional-v2-windows",
      "buildResources": "desktop/assets"
    },
    "files": [
      "package.json",
      "school-game/**/*"
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Geometry Tactical Professional V2 Local",
      "uninstallDisplayName": "Geometry Tactical Professional V2 Local"
    },
    "portable": {
      "artifactName": "Geometry-Tactical-Professional-V2-Local-${version}-Portable-${arch}.${ext}"
    }
  }
}
